{
  "name": "jarvis-backend",
  "main": "index.js",
  "compatibility_date": "2026-08-25",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,

    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },

    "traces": {
      "enabled": false
    }
  }
}
